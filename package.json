{
  "name": "sway",
  "version": "26.913.0-alpha",
  "description": "Dev workflow manager: session tree + Claude terminal + editor",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "lsp:install": "npm --prefix src-tauri/resources/lsp install",
    "dap:install": "node scripts/install-dap.mjs",
    "test": "node scripts/check-tokens.mjs && vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "license": "Apache-2.0",
