{
  "manifest_version": 3,
  "name": "Tori",
  "description": "Shows which Tori worktree a localhost tab is serving.",
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Tori", "default_icon": { "32": "icons/32.png" } },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "storage", "activeTab", "scripting"],
  "host_permissions": ["*://localhost/*", "*://127.0.0.1/*"],
  "optional_permissions": ["debugger", "webRequest"],
  "optional_host_permissions": ["<all_urls>"]
}
