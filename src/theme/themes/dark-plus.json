{
  "name": "Sway Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0e141b",
    "editor.foreground": "#e6e9f0",
    "foreground": "#e6e9f0",
    "descriptionForeground": "#8b929e",
    "focusBorder": "#4a9eff",
    "button.background": "#0e639c",
    "textLink.foreground": "#4a9eff",
    "sideBar.background": "#111720",
    "sideBar.foreground": "#e6e9f0",
    "sideBar.border": "#232c38",
    "sideBarSectionHeader.background": "#1b232e",
    "panel.border": "#232c38",
    "editorGroup.border": "#232c38",
    "tab.inactiveBackground": "#1b232e",
    "list.activeSelectionBackground": "#094771",
    "list.inactiveSelectionBackground": "#212b37",
    "list.hoverBackground": "#212b37",
    "input.background": "#1b232e",
    "dropdown.background": "#1b232e"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6a9955", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#569cd6" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#ce9178" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#dcdcaa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#9cdcfe" } }
  ]
}
