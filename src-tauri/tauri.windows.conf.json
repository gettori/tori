{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm lsp:install && pnpm dap:install && pnpm cli:build && pnpm dev",
    "beforeBuildCommand": "pnpm lsp:install && pnpm dap:install && pnpm cli:build && pnpm build"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$TEMP/**", "?:/**", "\\\\?\\?:/**"]
      }
    }
  },
  "bundle": {
    "externalBin": ["binaries/tori-cli"],
    "resources": [
      "resources/lsp/**/*",
      "resources/schemas/**/*",
      "resources/dap/**/*",
      "resources/autopilot/**/*",
      "resources/sounds/*.wav"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
