{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sway",
  "version": "26.904.0-alpha",
  "identifier": "com.skarif.sway",
  "build": {
    "beforeDevCommand": "pnpm lsp:install && pnpm dap:install && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm lsp:install && pnpm dap:install && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sway",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$HOME/.config/sway/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/lsp/**/*", "resources/schemas/**/*", "resources/dap/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
