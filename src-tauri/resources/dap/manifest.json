  "entry": "js-debug/src/dapDebugServer.js",
  "expect": {
    "readiness": "Debug server listening at",
    "reverseRequests": [
      "launchUnelevated",
      "launchVSCode",
      "remoteFileExists",
      "runInTerminal",
      "startDebugging"
